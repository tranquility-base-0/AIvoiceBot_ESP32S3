# =============================================================================
# Track B Host Bridge Configuration (.env)
# =============================================================================

# Server Bind Settings
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8765

# Speech-to-Text (STT) Backend: "faster_whisper" (local) or "deepgram" (cloud proxy)
STT_BACKEND=faster_whisper
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY

# Voice Activity Detection (VAD) / Endpointing Parameters (16 kHz s16le input)
VAD_RMS_THRESHOLD=350.0
VAD_SILENCE_MS=900
VAD_MIN_SPEECH_MS=300

# LLM Configuration (Groq Cloud or Local OpenAI-Compatible Server)
GROQ_API_KEY=YOUR_GROQ_API_KEY
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
SYSTEM_PROMPT_FILE=personas/system_prompt.txt

# Kokoro-ONNX TTS Configuration (24000 Hz s16le output)
KOKORO_MODEL_PATH=kokoro-v1.0.onnx
KOKORO_VOICES_PATH=voices-v1.0.bin
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_LANG=en-us

# Optional Glitch / DSP Hook (Max Headroom stutter & espeak-ng robotic bursts)
ENABLE_GLITCH_DSP=false
GLITCH_STUTTER_PROB=0.18
GLITCH_ESPEAK_PROB=0.10
